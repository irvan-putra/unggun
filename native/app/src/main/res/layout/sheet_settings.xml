<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="settings"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="github token (optional, raises rate limit)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:text="without a token github allows 60 checks per hour. the token is stored encrypted (android keystore) and never logged."
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_notify_updates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="notify when updates are available" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_delete_after_install"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="delete apk after install (frees cache)" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_notify_errors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="notify on errors" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="save" />

</LinearLayout>
